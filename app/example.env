# Environment Variables for Emotion Recognition & Knowledge Base API

# ======================
# OpenAI Configuration (Cloud)
# ======================
# Required for AI Agent analysis and optional for embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1  # Valid options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1  # Default OpenAI endpoint

# ======================
# Local LLM Configuration
# ======================
# For running local models (Ollama, LM Studio, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1  # Ollama default
LOCAL_LLM_MODEL=llama3  # or llama2, mistral, etc.
LOCAL_LLM_API_KEY=ollama  # Some local servers require a dummy key

# ======================
# Knowledge Base Settings
# ======================
# Embedding model: "sentence-transformers" (default, no API key needed) or "openai"
EMBEDDING_MODEL=sentence-transformers

# Storage path (relative to app directory)
KNOWLEDGE_BASE_STORAGE_PATH=./knowledge_base/storage

# ======================
# API Configuration
# ======================
# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=false

# ======================
# Optional: Other LLM Providers
# ======================
# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugging Face (for alternative models)
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ======================
# Agent Configuration
# ======================
# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
AGENT_TEMPERATURE=0.7

# Maximum tokens for agent responses
AGENT_MAX_TOKENS=2000

# Number of knowledge base results to retrieve
AGENT_KB_TOP_K=5

# Minimum similarity threshold for knowledge base retrieval
AGENT_KB_SIMILARITY_THRESHOLD=0.5

# ======================
# PageIndex Configuration (Reasoning-based RAG, Cloud API)
# ======================
# Enable/disable PageIndex
PAGEINDEX_ENABLED=true

# PageIndex Cloud API (required when using API mode)
# Get your API key from https://dash.pageindex.ai
PAGEINDEX_API_KEY=

# Directory for user–document mapping (no local tree files; default: ./pageindex_api_docs)
PAGEINDEX_API_DOCS_DIR=./pageindex_api_docs

# ======================
# Document Retrieval (PageIndex)
# ======================
HYBRID_ENABLED=true
USE_PAGEINDEX=true

# Merge strategy: llm, weighted, pageindex_first
MERGE_STRATEGY=llm
MERGER_MODEL=gpt-4o-mini
MERGER_TEMPERATURE=0.3
MERGER_MAX_TOKENS=2000
PAGEINDEX_WEIGHT=1.0

# ======================
# Opik (Comet) – LLM observability and evaluation
# ======================
# Set these to send LLM traces to Opik for debugging and evaluation.
# Get your API key and workspace from https://www.comet.com/signup
OPIK_API_KEY=your_comet_api_key_here
OPIK_WORKSPACE=your_workspace_name
# Do not set OPIK_URL_OVERRIDE — Opik targets Cloud automatically when api_key and workspace are set.
# Optional: override project name (defaults: metai-emotion, metai-streamlit, metai-merger per component)
# OPIK_PROJECT_NAME=metai

# ======================
# Logging
# ======================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
